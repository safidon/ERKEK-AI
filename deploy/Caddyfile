{
	email {$ACME_EMAIL}
}

# www -> негізгі домен
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API: /api/... -> backend (/api префиксі алынып тасталады)
	handle_path /api/* {
		reverse_proxy backend:8000 {
			# Чат жауабы stream түрінде келеді — буферлемейміз.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}
