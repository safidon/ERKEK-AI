# ERKEK AI production баптаулары.
# Көшірме жасаңыз:  cp deploy/.env.example deploy/.env  — содан кейін толтырыңыз.
# deploy/.env файлын ешқашан git-ке салмаңыз.

# Домен (DNS A-жазбасы осы серверге бағытталуы керек)
DOMAIN=example.kz
# Let's Encrypt хабарламалары үшін email
ACME_EMAIL=admin@example.kz

# OpenAI
OPENAI_API_KEY=

# JWT (кемінде 32 таңба). Жасау:  openssl rand -hex 32
JWT_SECRET_KEY=

# PostgreSQL. Құпиясөз жасау:  openssl rand -hex 24
POSTGRES_DB=erkek_ai
POSTGRES_USER=erkek
POSTGRES_PASSWORD=

# Rate limiting (минутына, бір IP-ге)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# Backup қанша күн сақталады
BACKUP_KEEP_DAYS=14

# Email (құпиясөзді қалпына келтіру хаттары) — міндетті.
# Мысалы: Resend, Brevo, Mailgun, Gmail (App password) SMTP деректері.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.kz
SMTP_SECURITY=starttls

# OpenAI шығынын бақылау
# Бір пайдаланушыға күніне хабарлама саны
DAILY_MESSAGES_PER_USER=50
# Бүкіл сайтқа күніне токен (0 = шектеусіз). Бір хабарлама ~4-5 мың токен.
DAILY_SITE_TOKEN_BUDGET=2000000
# Күн қай уақыт белдеуімен ауысады (Қазақстан: 5)
USAGE_TZ_OFFSET_HOURS=5
