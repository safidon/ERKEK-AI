APP_ENV=development

APP_NAME=ERKEK AI
APP_VERSION=1.0.0

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=

OPENAI_API_KEY=your_openai_api_key_here
JWT_SECRET_KEY=your_jwt_secret_here
# OpenAI (міндетті емес)
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low

# Email (құпиясөзді қалпына келтіру хаттары)
# Бос болса, dev режимінде хат логқа жазылады.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# Сессия (міндетті емес)
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI шығынын бақылау
# Бір пайдаланушыға күніне хабарлама саны
DAILY_MESSAGES_PER_USER=50
# Бүкіл сайтқа күніне токен (0 = шектеусіз). Бір хабарлама ~4-5 мың токен.
DAILY_SITE_TOKEN_BUDGET=2000000
# Күн қай уақыт белдеуімен ауысады (Қазақстан: 5)
USAGE_TZ_OFFSET_HOURS=5
